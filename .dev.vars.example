# 本機開發：複製為 .dev.vars（Vite / Wrangler 會讀取；已被 .gitignore 排除）
# 正式環境：在 ChatGPT Sites → Settings → Environment Variables 設定

# 第一位管理員的 ChatGPT 登入 Email；首次登入時自動建立 admin 帳號，之後由管理員在後台新增其他成員
INITIAL_ADMIN_EMAIL=

# "1" 時登入頁顯示示範身分（不需 ChatGPT 帳號即可切換身分）。正式站請留空或刪除！
DEMO_LOGIN=

# "1" 時資料庫為空會自動寫入示範資料，並允許「重設示範資料」。正式站請留空！
SEED_DEMO_DATA=

# 限時下載連結用的密鑰（任意 32 字元以上隨機字串；可用 openssl rand -hex 32 產生）
FILE_LINK_SECRET=

# LINE Messaging API（官方帳號）。三個都填才會推播；LINE_GROUP_ID 可在把官方帳號加入群組後，由 webhook 回覆取得
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_GROUP_ID=
